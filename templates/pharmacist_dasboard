{% extends "base.html" %}
{% block content %}
<div class="container">
    <header class="dashboard-header">
        <h1>Panel Farmacéutico</h1>
        <p>Control de inventario de sucursal, dispensación de recetas y traspasos.</p>
    </header>

    <!-- VALIDACIÓN DE RECETAS -->
    <section class="pharmacist-section">
        <h2>Validar y Despachar Receta</h2>
        <div class="form-grid" style="margin-bottom: 1.5rem;">
            <div class="form-group">
                <label>Código de Receta o C.I. Paciente:</label>
                <input type="text" placeholder="Ej. REC-9921">
            </div>
            <div class="form-group" style="display: flex; align-items: flex-end;">
                <button class="btn">Verificar Receta</button>
            </div>
        </div>
    </section>

    <!-- INVENTARIO DE SUCURSAL Y TRASPASOS -->
    <section class="pharmacist-section" style="margin-top: 2rem;">
        <div class="section-toolbar">
            <h2>Inventario de Sucursal y Traspasos</h2>
            <button class="btn" onclick="openModal('transferModal')">+ Registrar Traspaso / Cambio</button>
        </div>

        <div class="table-responsive">
            <table>
                <thead>
                    <tr>
                        <th>Medicamento</th>
                        <th>Lote</th>
                        <th>Stock Actual</th>
                        <th>Sucursal</th>
                        <th>Estado</th>
                        <th>Acción</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td>Ibuprofeno 400mg</td>
                        <td>L-8821</td>
                        <td>150 cajas</td>
                        <td>Sucursal Central</td>
                        <td>Disponible</td>
                        <td>
                            <button class="btn-sm btn-edit">Actualizar Stock</button>
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>
    </section>
</div>
{% endblock %}