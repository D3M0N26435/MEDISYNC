rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function profilePath(uid) {
      return /databases/$(database)/documents/users/$(uid);
    }

    function isAdmin() {
      return signedIn()
        && exists(profilePath(request.auth.uid))
        && get(profilePath(request.auth.uid)).data.role == 'admin'
        && (!('active' in get(profilePath(request.auth.uid)).data)
          || get(profilePath(request.auth.uid)).data.active == true);
    }

    match /users/{userId} {
      allow get: if signedIn() && (request.auth.uid == userId || isAdmin());
      allow list: if isAdmin();
      allow create, update, delete: if isAdmin();
    }

    match /locations/{locationId} {
      allow read: if signedIn();
      allow create, update, delete: if isAdmin();
    }
  }
}
