SESSION_COOKIE_SECURE=false

apiKey=
authDomain=
projectId=
storageBucket=
messagingSenderId=
appId=

# MediBot con MedGemma desplegado en Vertex AI Model Garden.
AI_PROVIDER=vertex
AI_MODEL=google/medgemma-1.5-4b-it
AI_PROJECT_ID=
AI_LOCATION=us-central1
AI_ENDPOINT_ID=

# Alternativa para cualquier proveedor compatible con OpenAI Chat Completions:
# AI_PROVIDER=openai_compatible
# AI_BASE_URL=https://proveedor.example/v1
# AI_API_KEY=

# Solo para usar IA desde Vertex AI; no se necesita para iniciar sesión con Firebase.
# GOOGLE_APPLICATION_CREDENTIALS=/ruta/privada/credenciales-google-cloud.json
