# Sesión local. En producción HTTPS usa true.
SESSION_COOKIE_SECURE=false

# Firebase web (obligatorio para iniciar sesión).
apiKey=
authDomain=
projectId=
storageBucket=
messagingSenderId=
appId=

# Telegram (chat de soporte del panel del paciente).
# tokenTelegram: token que entrega @BotFather (también se acepta token_telegram).
# chatIdTelegram: ID numérico del grupo de soporte (los grupos suelen empezar por -).
# CHAT_BRIDGE_SECRET: cadena larga inventada; debe ser la misma en app.py y bot.py.
# APP_BASE_URL: URL que el bot puede alcanzar para devolver respuestas al portal.
tokenTelegram=
chatIdTelegram=
CHAT_BRIDGE_SECRET=
APP_BASE_URL=http://127.0.0.1:5000

# Gemini. La misma clave sirve para bot.py y para MediBot del paciente.
# Puedes usar apiGoogle o GEMINI_API_KEY, pero no hace falta poner las dos.
apiGoogle=
# GEMINI_API_KEY=

# Modelo del bot de Telegram.
GEMINI_MODEL=gemini-3.5-flash-lite

# MediBot del paciente (app.py) usando la API key de Gemini.
AI_PROVIDER=openai_compatible
AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
AI_MODEL=gemini-3.5-flash-lite
# Si queda vacío, app.py reutiliza apiGoogle o GEMINI_API_KEY.
AI_API_KEY=

# Opcional: usar Vertex AI en lugar de la API key de Gemini.
# No hace falta para el bot de Telegram ni para el chat de soporte.
# AI_PROVIDER=vertex
# AI_MODEL=google/medgemma-1.5-4b-it
# AI_PROJECT_ID=
# AI_LOCATION=us-central1
# AI_ENDPOINT_ID=
# GOOGLE_APPLICATION_CREDENTIALS=/ruta/privada/credenciales-google-cloud.json
